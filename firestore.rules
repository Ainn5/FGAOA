rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInResident() {
      return request.auth != null
        && exists(/databases/$(database)/documents/residents/$(request.auth.uid))
        && get(/databases/$(database)/documents/residents/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/residents/$(request.auth.uid)).data.phoneNumber == request.auth.token.phone_number;
    }
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }
    match /residents/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }
    match /contacts/{contactId} {
      allow read: if signedInResident();
      allow create, update, delete: if isAdmin();
    }
  }
}